---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DestinationCard from "../components/DestinationCard.astro";
import PreferenceSwiper from "../components/PreferenceSwiper.astro";
import Icon from "../components/Icon.astro";
import { destinations } from "../data/destinations";
import { categories } from "../data/categories";
import { regions } from "../data/regions";
import { experiences } from "../data/experiences";
const featured=destinations.filter(d=>d.featured),base=import.meta.env.BASE_URL;
---
<Layout title="ExploreGabon — Découvrez le Gabon">
  <Header />
  <main>
    <section class="home-hero relative isolate overflow-hidden bg-slate-950">
      <img src="https://images.unsplash.com/photo-1516026672322-bc52d61a55d5?auto=format&fit=crop&w=2200&q=90" alt="Paysage naturel du Gabon" class="hero-image absolute inset-0 -z-20 h-full w-full object-cover" />
      <div class="hero-overlay absolute inset-0 -z-10"></div>
      <div class="kota-pattern absolute inset-0 -z-10 opacity-[0.06]"></div>
      <div class="container-site flex min-h-[560px] items-end pb-16 pt-20 sm:min-h-[600px] sm:pb-20">
        <div class="max-w-4xl text-white">
          <span class="hero-kicker reveal">🇬🇦 Mbolo — Bienvenue au Gabon</span>
          <h1 class="reveal mt-5 max-w-3xl text-4xl font-black leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">Trouvez votre prochaine découverte au Gabon.</h1>
          <p class="reveal mt-5 max-w-2xl text-base leading-7 text-slate-200 sm:text-lg">Des plages aux forêts, explorez les destinations et expériences qui correspondent à vos envies.</p>
        </div>
      </div>
    </section>

    <section class="bg-white pb-14 pt-14" id="explore">
      <div class="container-site">
        <div class="reveal flex items-end justify-between gap-6"><div><p class="section-eyebrow">Explorer</p><h2 class="section-title">Que voulez-vous découvrir ?</h2></div><a href={`${base}destinations/`} class="section-link hidden sm:block">Voir toutes les destinations →</a></div>
        <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-8">
          {categories.map(category=><a href={`${base}destinations/?category=${encodeURIComponent(category.name)}`} class="category-tile reveal"><span class="category-icon"><Icon name={category.icon} class="h-7 w-7" /></span><span class="mt-4 text-sm font-bold text-slate-900">{category.name}</span><span class="mt-1 text-xs text-slate-500">Découvrir</span></a>)}
        </div>
      </div>
    </section>

    <PreferenceSwiper />

    <section class="section-pad bg-slate-50">
      <div class="container-site">
        <div class="reveal flex items-end justify-between gap-6"><div><p id="featured-eyebrow" class="section-eyebrow">Sélection</p><h2 id="featured-title" class="section-title">Destinations à découvrir</h2></div><a href={`${base}destinations/`} class="section-link hidden sm:block">Tout voir →</a></div>
        <div id="featured-grid" class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">{featured.map(destination=><div class="reveal featured-item" data-category={destination.category}><DestinationCard destination={destination}/></div>)}</div>
      </div>
    </section>

    <section class="section-pad">
      <div class="container-site"><div class="territory-banner reveal overflow-hidden rounded-3xl"><div class="grid lg:grid-cols-2"><div class="p-8 sm:p-12 lg:p-14"><p class="section-eyebrow text-brand-400">Le territoire</p><h2 class="mt-3 text-3xl font-black text-white sm:text-4xl">Explorez le Gabon région par région.</h2><p class="mt-5 max-w-xl leading-7 text-slate-300">Parcourez les provinces et trouvez les destinations qui correspondent à votre prochaine découverte.</p><a href={`${base}regions/`} class="primary-light mt-8 inline-flex">Explorer les régions <Icon name="arrow" class="h-4 w-4" /></a></div><div class="min-h-[320px] bg-cover bg-center" style={`background-image:url('${regions[1].image}')`}></div></div></div></div>
    </section>

    <section class="section-pad bg-white">
      <div class="container-site"><div class="reveal"><p class="section-eyebrow">Expériences</p><h2 class="section-title">Voyagez selon vos envies.</h2></div><div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{experiences.map(experience=><a href={`${base}destinations/?category=${encodeURIComponent(experience.category)}`} class="experience-card reveal"><span class="experience-icon"><Icon name={experience.icon} class="h-6 w-6" /></span><h3 class="mt-5 font-extrabold text-slate-950">{experience.title}</h3><p class="mt-2 text-sm leading-6 text-slate-500">{experience.description}</p><span class="mt-5 inline-flex items-center gap-1 text-sm font-bold text-brand-700">Découvrir <Icon name="arrow" class="h-4 w-4" /></span></a>)}</div></div>
    </section>
  </main>
  <Footer />
</Layout>
<script>
const choices=JSON.parse(localStorage.getItem('gabon-preferences')||'[]');if(choices.length){const grid=document.getElementById('featured-grid'),items=[...document.querySelectorAll('.featured-item')],matching=items.filter(i=>choices.includes(i.dataset.category)),rest=items.filter(i=>!choices.includes(i.dataset.category));[...matching,...rest].forEach(i=>grid.appendChild(i));if(matching.length){document.getElementById('featured-eyebrow').textContent='Pour vous';document.getElementById('featured-title').textContent='Sélection selon vos préférences';}}
</script>
