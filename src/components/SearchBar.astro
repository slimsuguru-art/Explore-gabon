---
import Icon from "./Icon.astro";
---
<form id="search-form" class="search-panel" aria-label="Rechercher une destination">
  <div class="search-field">
    <span class="search-icon"><Icon name="search" class="h-5 w-5" /></span>
    <div class="min-w-0 flex-1">
      <label for="search-input" class="search-label">Destination</label>
      <input id="search-input" name="q" class="search-input" placeholder="Où souhaitez-vous aller ?" />
    </div>
  </div>
  <div class="search-divider"></div>
  <div class="search-field">
    <span class="search-icon"><Icon name="compass" class="h-5 w-5" /></span>
    <div class="min-w-0 flex-1">
      <label for="category-input" class="search-label">Expérience</label>
      <input id="category-input" name="category" class="search-input" placeholder="Plage, forêt, culture..." />
    </div>
  </div>
  <button class="search-submit focus-ring" type="submit"><Icon name="search" class="h-5 w-5" /> Rechercher</button>
</form>
<script>
  document.getElementById("search-form")?.addEventListener("submit", (e) => {
    e.preventDefault();
    const q = document.getElementById("search-input")?.value.trim();
    const category = document.getElementById("category-input")?.value.trim();
    const base = import.meta.env.BASE_URL;
    const params = new URLSearchParams();
    if (q) params.set("q", q); if (category) params.set("category", category);
    window.location.href = `${base}destinations/${params.toString() ? `?${params}` : ""}`;
  });
</script>
