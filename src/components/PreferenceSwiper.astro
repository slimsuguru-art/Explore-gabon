---
import { preferenceActivities } from '../data/preferences';
import Icon from './Icon.astro';
const base = import.meta.env.BASE_URL;
const iconMap = { Plages: 'wave', 'Parcs nationaux': 'leaf', Forêts: 'tree', 'Culture & nature': 'culture', Photographie: 'camera' };
---
<section class="section-pad bg-slate-950 text-white" id="preferences">
  <div class="container-site">
    <div class="mx-auto max-w-2xl text-center"><p class="text-xs font-extrabold uppercase tracking-[.16em] text-brand-400">Votre voyage, vos envies</p><h2 class="mt-3 text-3xl font-black sm:text-4xl">Quel type d'expérience recherchez-vous ?</h2><p class="mt-4 leading-7 text-slate-300">Faites défiler les expériences qui vous attirent pour préparer une sélection plus personnelle.</p></div>
    <div class="mx-auto mt-8 max-w-xs sm:max-w-sm">
      <div id="preference-deck" class="relative h-[320px] sm:h-[360px]">
        {preferenceActivities.map((activity, index) => (
          <article class="preference-card absolute inset-0 overflow-hidden rounded-[1.5rem] border border-white/10 bg-slate-900 shadow-2xl" data-id={activity.id} data-category={activity.category} style={`z-index:${preferenceActivities.length-index};transform:translateY(${index*5}px) scale(${1-index*.018});opacity:${1-index*.045};`}>
            <img src={activity.image} alt={activity.title} class="h-full w-full object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-5"><span class="inline-flex items-center gap-1.5 rounded-full bg-white/15 px-2.5 py-1 text-xs font-bold backdrop-blur"><Icon name={iconMap[activity.category] || 'compass'} class="h-3.5 w-3.5" /> {activity.category}</span><h3 class="mt-3 text-xl font-extrabold">{activity.title}</h3><p class="mt-1 text-sm leading-5 text-slate-200">{activity.description}</p></div>
          </article>
        ))}
      </div>
      <div class="mt-5 flex items-center justify-center gap-3"><button type="button" data-swipe="no" aria-label="Passer" class="swipe-btn secondary">×</button><button type="button" data-swipe="yes" aria-label="J'aime" class="swipe-btn primary">♥</button><button type="button" data-swipe="save" aria-label="Garder" class="swipe-btn secondary">★</button></div>
      <div class="mt-5 text-center"><p id="preference-status" class="text-sm text-slate-400">Choisissez vos activités préférées.</p><a id="preference-results" href={`${base}destinations/`} class="mt-4 hidden inline-flex rounded-xl bg-white px-5 py-3 text-sm font-bold text-slate-950">Voir mes découvertes →</a></div>
    </div>
  </div>
</section>
<script define:vars={{ base }}>
const cards=[...document.querySelectorAll('.preference-card')],status=document.querySelector('#preference-status'),results=document.querySelector('#preference-results'),deck=document.querySelector('#preference-deck');const choices=JSON.parse(localStorage.getItem('gabon-preferences')||'[]');let current=cards.length-1,startX=0;
const refresh=()=>{cards.forEach((card,index)=>{const d=current-index;if(d<0)return;card.style.zIndex=String(index+1);card.style.transform=`translateY(${d*5}px) scale(${1-d*.018})`;card.style.opacity=String(Math.max(0,1-d*.045));});status.textContent=current>=0?`${choices.length} préférence${choices.length>1?'s':''} sélectionnée${choices.length>1?'s':''}`:'Vos préférences sont prêtes.';if(current<0){results.classList.remove('hidden');results.href=choices[0]?`${base}destinations/?category=${encodeURIComponent(choices[0])}`:`${base}destinations/`;}};
const swipe=(liked)=>{if(current<0)return;const card=cards[current];if(liked)choices.push(card.dataset.category);localStorage.setItem('gabon-preferences',JSON.stringify([...new Set(choices)]));card.style.transition='transform .35s ease,opacity .35s ease';card.style.transform=`translate(${liked?120:-120}%,20px) rotate(${liked?10:-10}deg)`;card.style.opacity='0';current--;setTimeout(refresh,260);};
document.querySelectorAll('[data-swipe]').forEach(b=>b.addEventListener('click',()=>swipe(b.dataset.swipe!=='no')));deck.addEventListener('pointerdown',e=>{startX=e.clientX});deck.addEventListener('pointerup',e=>{const d=e.clientX-startX;if(Math.abs(d)>70)swipe(d>0)});refresh();
</script>
