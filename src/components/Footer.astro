---
const base = import.meta.env.BASE_URL;
---
<footer class="kota-pattern relative border-t border-slate-800 bg-slate-950 text-white">
  <div class="tricolor-bar h-[3px] w-full"></div>
  <div class="container-site flex flex-col items-center gap-4 py-8 text-center sm:flex-row sm:justify-between sm:text-left">
    <div class="font-display text-lg font-bold">Explore<span class="text-brand-400">Gabon</span></div>
    <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm text-slate-400"><a class="hover:text-white" href={`${base}destinations/`}>Destinations</a><a class="hover:text-white" href={`${base}favoris/`}>Favoris</a><a class="hover:text-white" href={`${base}connexion/`}>Connexion</a></nav>
    <p class="text-xs text-slate-500">© {new Date().getFullYear()} ExploreGabon</p>
  </div>
</footer>
