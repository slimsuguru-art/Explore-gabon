---
// Each badge is an independent, simplified redrawing of the province's real heraldic charges
// (colors + key symbols), not a copy of any single artist's rendering.
const { id, size = 56 } = Astro.props;
const shield = "M6,4 H54 V32 C54,50 40,58 30,62 C20,58 6,50 6,32 Z";
---
<svg viewBox="0 0 60 64" width={size} height={size * 64/60} role="img" aria-label={`Blason de ${id}`}>
  <defs><clipPath id={`clip-${id}`}><path d={shield} /></clipPath></defs>
  <g clip-path={`url(#clip-${id})`}>
    {id === "estuaire" && <>
      <rect width="60" height="64" fill="#FCD116" />
      <polygon points="30,8 12,58 48,58" fill="#3A75C4" />
      <g fill="#fff">
        <rect x="27" y="20" width="6" height="6" /><rect x="20" y="32" width="6" height="6" /><rect x="34" y="32" width="6" height="6" />
        <rect x="14" y="44" width="6" height="6" /><rect x="27" y="44" width="6" height="6" /><rect x="40" y="44" width="6" height="6" />
      </g>
    </>}
    {id === "ogooue-maritime" && <>
      <rect width="60" height="64" fill="#0f172a" />
      <path d="M0,46 Q10,40 20,46 T40,46 T60,46 V64 H0 Z" fill="#3A75C4" />
      <path d="M0,52 Q10,47 20,52 T40,52 T60,52 V64 H0 Z" fill="#fff" opacity=".8" />
      <g fill="#FCD116">
        <path d="M18,14 C14,20 16,26 20,28 C17,22 20,18 22,14 C24,20 22,24 24,28 C28,24 26,16 18,14 Z" />
        <path d="M30,10 C26,17 28,24 32,26 C29,19 32,15 34,10 C36,17 34,22 36,26 C40,22 38,13 30,10 Z" />
        <path d="M42,14 C38,20 40,26 44,28 C41,22 44,18 46,14 C48,20 46,24 48,28 C52,24 50,16 42,14 Z" />
      </g>
    </>}
    {id === "nyanga" && <>
      <rect width="60" height="32" fill="#b91c1c" />
      <path d="M0,32 Q10,26 20,32 T40,32 T60,32 V64 H0 Z" fill="#3A75C4" />
      <path d="M0,40 Q10,35 20,40 T40,40 T60,40 V64 H0 Z" fill="#fff" opacity=".7" />
      <path d="M30,8 C22,8 16,14 16,20 C16,15 22,12 27,14 C24,10 28,8 30,8 C32,8 36,10 33,14 C38,12 44,15 44,20 C44,14 38,8 30,8 Z" fill="#FCD116" />
      <g fill="#e5e7eb">
        <path d="M14,48 q4,-4 8,0 q-4,4 -8,0 Z" /><path d="M26,52 q4,-4 8,0 q-4,4 -8,0 Z" /><path d="M38,48 q4,-4 8,0 q-4,4 -8,0 Z" />
      </g>
    </>}
    {id === "ngounie" && <>
      <rect width="60" height="64" fill="#FCD116" />
      <rect y="8" width="60" height="14" fill="#b91c1c" />
      <g fill="#fef3c7">
        <polygon points="8,15 14,9 20,15 14,21" /><polygon points="22,15 28,9 34,15 28,21" /><polygon points="36,15 42,9 48,15 42,21" />
      </g>
      <ellipse cx="30" cy="42" rx="13" ry="16" fill="#1c1917" />
      <circle cx="24" cy="38" r="2.2" fill="#FCD116" /><circle cx="36" cy="38" r="2.2" fill="#FCD116" />
      <line x1="30" y1="41" x2="30" y2="48" stroke="#FCD116" stroke-width="1.5" />
      <path d="M23,52 Q30,57 37,52" stroke="#FCD116" stroke-width="1.5" fill="none" />
    </>}
    {id === "moyen-ogooue" && <>
      <rect width="60" height="64" fill="#FCD116" />
      <path d="M0,34 Q10,29 20,34 T40,34 T60,34 V64 H0 Z" fill="#3A75C4" />
      <g fill="#1c1917">
        <ellipse cx="26" cy="20" rx="11" ry="8" />
        <ellipse cx="16" cy="17" rx="4" ry="5" />
        <path d="M17,22 q-5,2 -6,9" stroke="#1c1917" stroke-width="2.5" fill="none" stroke-linecap="round" />
        <rect x="20" y="26" width="3" height="6" /><rect x="27" y="26" width="3" height="6" /><rect x="34" y="24" width="3" height="7" />
      </g>
      <g fill="#3A75C4"><circle cx="20" cy="52" r="5" /><circle cx="30" cy="55" r="5" /><circle cx="40" cy="52" r="5" /></g>
    </>}
    {id === "ogooue-ivindo" && <>
      <rect width="60" height="64" fill="#b91c1c" />
      {Array.from({length:10}).map((_,i)=>(
        <g fill="#FCD116" transform={`translate(${8+(i%4)*13},${10+Math.floor(i/4)*16})`}>
          <ellipse cx="0" cy="0" rx="3.5" ry="2.4" /><path d="M-3,-1 l-3,-2 M3,-1 l3,-2" stroke="#FCD116" stroke-width="1" />
        </g>
      ))}
      <polygon points="30,20 20,42 26,42 26,58 34,58 34,42 40,42" fill="#fff" />
    </>}
    {id === "ogooue-lolo" && <>
      <rect width="30" height="64" fill="#b91c1c" /><rect x="30" width="30" height="64" fill="#FCD116" />
      <g fill="#1c1917">
        <ellipse cx="30" cy="30" rx="9" ry="7" />
        <circle cx="24" cy="24" r="3.2" /><circle cx="36" cy="24" r="3.2" />
        <path d="M21,30 C10,26 6,36 12,42 C14,36 20,34 24,36 Z" />
        <path d="M39,30 C50,26 54,36 48,42 C46,36 40,34 36,36 Z" />
        <path d="M27,37 L23,52 M33,37 L37,52 M30,38 L30,54" stroke="#1c1917" stroke-width="2" />
      </g>
    </>}
    {id === "haut-ogooue" && <>
      <rect width="60" height="64" fill="#0f172a" />
      <rect y="6" width="60" height="14" fill="#FCD116" />
      <g fill="#1c1917"><ellipse cx="14" cy="13" rx="3.4" ry="2.2" /><ellipse cx="26" cy="13" rx="3.4" ry="2.2" /><ellipse cx="38" cy="13" rx="3.4" ry="2.2" /><ellipse cx="49" cy="13" rx="3.4" ry="2.2" /></g>
      <g stroke="#e5e7eb" stroke-width="3" stroke-linecap="round"><line x1="16" y1="34" x2="44" y2="54" /><line x1="44" y1="34" x2="16" y2="54" /></g>
      <g fill="#fff"><polygon points="30,38 34,42 30,46 26,42" /><polygon points="20,46 24,50 20,54 16,50" /><polygon points="40,46 44,50 40,54 36,50" /></g>
    </>}
    {id === "woleu-ntem" && <>
      <rect width="60" height="64" fill="#15803d" />
      <path d="M0,30 Q10,25 20,30 T40,30 T60,30" stroke="#fff" stroke-width="3" fill="none" />
      <path d="M0,42 Q10,37 20,42 T40,42 T60,42" stroke="#fff" stroke-width="3" fill="none" />
      <g fill="#FCD116">
        <path d="M16,10 C11,15 12,22 17,25 C15,19 18,14 20,10 C22,15 20,19 22,24 C27,21 25,12 16,10 Z" />
        <path d="M30,6 C25,11 26,18 31,21 C29,15 32,10 34,6 C36,11 34,15 36,20 C41,17 39,8 30,6 Z" />
        <path d="M44,10 C39,15 40,22 45,25 C43,19 46,14 48,10 C50,15 48,19 50,24 C55,21 53,12 44,10 Z" />
      </g>
    </>}
  </g>
  <path d={shield} fill="none" stroke="white" stroke-width="2" />
</svg>
