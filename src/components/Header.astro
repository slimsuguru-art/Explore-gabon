---
const base = import.meta.env.BASE_URL;
---
<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/95 backdrop-blur">
  <div class="container-site flex h-[76px] items-center gap-6 lg:grid lg:grid-cols-[1fr_auto_1fr]">
    <a href={base} class="focus-ring flex items-center gap-3 font-display text-xl font-bold tracking-tight text-slate-950"><span class="grid h-10 w-10 place-items-center rounded-xl bg-brand-700 text-lg text-white shadow-sm">G</span><span>Explore<span class="text-brand-700">Gabon</span></span></a>
    <nav class="hidden items-center justify-center gap-1 text-sm font-semibold lg:flex" aria-label="Navigation principale">
      <a class="rounded-lg px-3 py-2 transition hover:bg-brand-50 hover:text-brand-700" href={base + "destinations/"}>Destinations</a><a class="rounded-lg px-3 py-2 transition hover:bg-brand-50 hover:text-brand-700" href={base + "experiences/"}>Expériences</a><a class="rounded-lg px-3 py-2 transition hover:bg-brand-50 hover:text-brand-700" href={base + "regions/"}>Régions</a><a class="rounded-lg px-3 py-2 transition hover:bg-brand-50 hover:text-brand-700" href={base + "#explore"}>Explorer</a>
    </nav>
    <div class="hidden items-center justify-end gap-3 lg:flex"><a href={base + "favoris/"} class="focus-ring inline-flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-brand-50 hover:text-brand-700">♡ Favoris</a><a id="auth-link" class="focus-ring rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-brand-50 hover:text-brand-700" href={base + "connexion/"}>Connexion</a><a href={base + "destinations/"} class="focus-ring rounded-xl bg-brand-700 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-brand-800">Explorer le Gabon</a></div>
    <button id="mobile-menu-btn" class="focus-ring ml-auto rounded-lg border border-slate-200 p-2 lg:hidden" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="mobile-menu">☰</button>
  </div>
</header>
<script>
import { supabase } from "../lib/supabase.js";
const btn=document.getElementById("mobile-menu-btn");
btn?.addEventListener("click",()=>{});
async function updateAuthUI(){const {data:{session}}=await supabase.auth.getSession();const el=document.getElementById("auth-link");if(session?.user&&el){el.textContent="👤 "+session.user.email.split("@")[0];el.href="#";}}
updateAuthUI();
</script>
