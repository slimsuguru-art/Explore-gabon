---
import Layout from "../../layouts/Layout.astro"; import Header from "../../components/Header.astro"; import Footer from "../../components/Footer.astro"; import DestinationCard from "../../components/DestinationCard.astro"; import Icon from "../../components/Icon.astro"; import { destinations } from "../../data/destinations"; import { sampleComments } from "../../data/comments";
export function getStaticPaths(){return destinations.map(destination=>({params:{slug:destination.slug},props:{destination}}));} const {destination}=Astro.props; const related=destinations.filter(d=>d.slug!==destination.slug&&(d.province===destination.province||d.category===destination.category)).slice(0,3); const base=import.meta.env.BASE_URL;
---
<Layout title={`${destination.name} — ExploreGabon`} description={destination.short}><Header/><main>
<section class="detail-hero relative isolate min-h-[520px] overflow-hidden bg-slate-950"><img src={destination.image} alt={destination.name} class="hero-image absolute inset-0 -z-20 h-full w-full object-cover"/><div class="hero-overlay absolute inset-0 -z-10"></div><div class="container-site flex min-h-[520px] items-end pb-12"><div class="max-w-3xl text-white"><span class="rounded-full bg-white/15 px-3 py-1.5 text-xs font-bold backdrop-blur">{destination.category}</span><h1 class="mt-5 text-4xl font-black tracking-tight sm:text-6xl">{destination.name}</h1><p class="mt-4 flex flex-wrap items-center gap-4 text-slate-200"><span class="inline-flex items-center gap-1.5"><Icon name="pin" class="h-4 w-4"/>{destination.province}</span><span class="inline-flex items-center gap-1.5"><Icon name="star" class="h-4 w-4 fill-current text-amber-400"/>{destination.rating}</span><span>{destination.reviews} avis</span></p></div></div></section>
<section class="section-pad"><div class="container-site grid gap-12 lg:grid-cols-[1.5fr_.75fr]"><div><p class="section-eyebrow">À propos</p><h2 class="section-title">Une destination à découvrir.</h2><p class="mt-5 text-base leading-8 text-slate-600">{destination.description}</p><h2 class="mt-12 text-2xl font-black">Expériences</h2><div class="mt-5 flex flex-wrap gap-3">{destination.activities.map(a=><span class="rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-semibold">{a}</span>)}</div></div><aside class="detail-aside"><div class="flex items-center justify-between"><span class="inline-flex items-center gap-1.5 font-bold"><Icon name="star" class="h-4 w-4 fill-current text-amber-500"/>{destination.rating}</span><span class="text-sm text-slate-500">{destination.reviews} avis</span></div><div class="my-6 h-px bg-slate-100"></div><h2 class="font-black">Informations pratiques</h2><dl class="mt-5 space-y-5 text-sm"><div><dt class="font-bold">Meilleure période</dt><dd class="mt-1 text-slate-500">{destination.bestPeriod}</dd></div><div><dt class="font-bold">Accès</dt><dd class="mt-1 leading-6 text-slate-500">{destination.access}</dd></div><div><dt class="font-bold">Région</dt><dd class="mt-1 text-slate-500">{destination.province}</dd></div></dl><button data-favorite={destination.slug} class="favorite-detail-btn focus-ring mt-7 w-full rounded-xl border border-slate-200 px-4 py-3 font-bold">♡ Ajouter aux favoris</button></aside></div></section>
<section class="section-pad bg-slate-50"><div class="container-site max-w-3xl"><p class="section-eyebrow">Avis</p><h2 class="section-title">Ce qu'en disent les visiteurs</h2><div id="comments-list" class="mt-8 space-y-4"></div><form id="comment-form" class="comment-card mt-8 space-y-4"><h3 class="font-black">Laisser un avis</h3><input id="comment-name" type="text" placeholder="Votre nom" required class="input-ui"/><div><p class="mb-1 text-xs font-semibold text-slate-500">Votre note</p><div class="flex items-center gap-1" id="star-picker" data-value="5">{[1,2,3,4,5].map(n=><span class="star-btn" data-star={n}>★</span>)}</div></div><textarea id="comment-text" rows="3" placeholder="Partagez votre expérience..." required class="input-ui"></textarea><button type="submit" class="btn-primary">Publier mon avis</button></form></div></section>
<section class="section-pad"><div class="container-site"><p class="section-eyebrow">À proximité</p><h2 class="section-title">Vous pourriez également découvrir</h2><div class="mt-8 grid gap-6 md:grid-cols-3">{related.map(item=><DestinationCard destination={item}/>)}</div></div></section>
</main><Footer/></Layout>
<script define:vars={{slug:destination.slug,seed:sampleComments}}>
const key=`gabon-comments-${slug}`,list=document.getElementById('comments-list'),form=document.getElementById('comment-form'),picker=document.getElementById('star-picker'),stars=[...picker.querySelectorAll('[data-star]')];const esc=s=>s.replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));function renderStars(v){stars.forEach(s=>s.classList.toggle('active',Number(s.dataset.star)<=v))}function render(){const stored=JSON.parse(localStorage.getItem(key)||'[]');list.innerHTML=[...stored,...seed].map(c=>`<div class="comment-card"><div class="flex items-center justify-between"><div><p class="font-bold">${esc(c.name)}</p><p class="text-xs text-slate-500">${esc(c.date)}</p></div><span class="text-amber-400">${'★'.repeat(c.rating)}${'☆'.repeat(5-c.rating)}</span></div><p class="mt-3 text-sm leading-6 text-slate-600">${esc(c.text)}</p></div>`).join('')}renderStars(5);stars.forEach(s=>s.addEventListener('click',()=>{picker.dataset.value=s.dataset.star;renderStars(Number(s.dataset.star))}));render();form.addEventListener('submit',e=>{e.preventDefault();const name=document.getElementById('comment-name').value.trim(),text=document.getElementById('comment-text').value.trim(),rating=Number(picker.dataset.value)||5;if(!name||!text)return;const arr=JSON.parse(localStorage.getItem(key)||'[]');arr.unshift({name,text,rating,date:new Date().toLocaleDateString('fr-FR',{month:'long',year:'numeric'})});localStorage.setItem(key,JSON.stringify(arr));form.reset();picker.dataset.value='5';renderStars(5);render()});
</script>
<script>document.querySelectorAll('[data-favorite]').forEach(b=>{const s=b.dataset.favorite,sync=()=>{const a=JSON.parse(localStorage.getItem('gabon-favorites')||'[]');b.textContent=a.includes(s)?'♥ Dans vos favoris':'♡ Ajouter aux favoris'};sync();b.addEventListener('click',()=>{const a=JSON.parse(localStorage.getItem('gabon-favorites')||'[]'),n=a.includes(s)?a.filter(x=>x!==s):[...a,s];localStorage.setItem('gabon-favorites',JSON.stringify(n));sync()})});</script>
