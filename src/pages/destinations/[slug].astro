---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import DestinationCard from "../../components/DestinationCard.astro";
import { destinations } from "../../data/destinations";
import { sampleComments } from "../../data/comments";
export function getStaticPaths() {
  return destinations.map((destination) => ({ params: { slug: destination.slug }, props: { destination } }));
}
const { destination } = Astro.props;
const related = destinations.filter((d) => d.slug !== destination.slug && (d.province === destination.province || d.category === destination.category)).slice(0, 3);
---
<Layout title={`${destination.name} — ExploreGabon`} description={destination.short}>
  <Header />
  <main>
    <section class="relative isolate min-h-[520px] overflow-hidden bg-slate-950">
      <img src={destination.image} alt={destination.name} class="hero-zoom absolute inset-0 -z-20 h-full w-full object-cover" />
      <div class="hero-gradient absolute inset-0 -z-10"></div>
      <div class="container-site flex min-h-[520px] items-end pb-12">
        <div class="max-w-3xl text-white">
          <span class="rounded-full bg-white/15 px-3 py-1.5 text-xs font-bold backdrop-blur">{destination.category}</span>
          <h1 class="mt-5 text-4xl font-extrabold tracking-tight sm:text-6xl">{destination.name}</h1>
          <p class="mt-3 text-slate-200">📍 {destination.province} · ⭐ {destination.rating} · {destination.reviews} avis</p>
        </div>
      </div>
    </section>
    <section class="section-pad">
      <div class="container-site grid gap-12 lg:grid-cols-[1.6fr_.8fr]">
        <div>
          <p class="text-sm font-bold uppercase tracking-wider text-brand-700">À propos</p>
          <h2 class="mt-2 text-3xl font-extrabold">Une destination à découvrir.</h2>
          <p class="mt-5 text-base leading-8 text-slate-600">{destination.description}</p>
          <h2 class="mt-12 text-2xl font-extrabold">Expériences</h2>
          <div class="mt-5 flex flex-wrap gap-3">{destination.activities.map((a) => <span class="chip-hover cursor-default rounded-full border border-transparent bg-slate-100 px-4 py-2 text-sm font-semibold">{a}</span>)}</div>
        </div>
        <aside class="h-fit rounded-2xl border border-slate-200 bg-white p-6 shadow-soft">
          <div class="flex items-center justify-between"><span class="font-bold">⭐ {destination.rating}</span><span class="text-sm text-slate-500">{destination.reviews} avis</span></div>
          <div class="my-6 h-px bg-slate-100"></div>
          <h2 class="font-extrabold">Informations pratiques</h2>
          <dl class="mt-5 space-y-5 text-sm">
            <div><dt class="font-bold">📅 Meilleure période</dt><dd class="mt-1 text-slate-500">{destination.bestPeriod}</dd></div>
            <div><dt class="font-bold">🚗 Accès</dt><dd class="mt-1 leading-6 text-slate-500">{destination.access}</dd></div>
            <div><dt class="font-bold">📍 Région</dt><dd class="mt-1 text-slate-500">{destination.province}</dd></div>
          </dl>
          <button data-favorite={destination.slug} class="favorite-btn focus-ring mt-7 w-full rounded-xl border border-slate-200 px-4 py-3 font-bold hover:border-brand-700 hover:text-brand-700">♡ Ajouter aux favoris</button>
        </aside>
      </div>
    </section>
    <section class="section-pad">
      <div class="container-site max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-wider text-brand-700">Avis</p>
        <h2 class="mt-2 text-3xl font-extrabold">Ce qu'en disent les visiteurs</h2>

        <div id="comments-list" class="mt-8 space-y-4"></div>

        <form id="comment-form" class="comment-card mt-8 space-y-4">
          <h3 class="font-extrabold">Laisser un avis</h3>
          <input id="comment-name" type="text" placeholder="Votre nom" required class="focus-ring w-full rounded-xl border border-slate-200 px-4 py-3 text-sm" />
          <div>
            <p class="mb-1 text-xs font-semibold text-slate-500">Votre note</p>
            <div class="flex items-center gap-1" id="star-picker" data-value="5">
              {[1, 2, 3, 4, 5].map((n) => <span class="star-btn" data-star={n}>★</span>)}
            </div>
          </div>
          <textarea id="comment-text" rows="3" placeholder="Partagez votre expérience..." required class="focus-ring w-full rounded-xl border border-slate-200 px-4 py-3 text-sm"></textarea>
          <button type="submit" class="focus-ring rounded-xl bg-brand-700 px-6 py-3 font-bold text-white transition hover:bg-brand-800">Publier mon avis</button>
        </form>
      </div>
    </section>
    <section class="section-pad bg-slate-50">
      <div class="container-site">
        <p class="text-sm font-bold uppercase tracking-wider text-brand-700">À proximité</p>
        <h2 class="mt-2 text-3xl font-extrabold">Vous pourriez également découvrir</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-3">{related.map((item) => <DestinationCard destination={item} />)}</div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
<script define:vars={{ slug: destination.slug, seed: sampleComments }}>
  const commentsKey = `gabon-comments-${slug}`;
  const list = document.getElementById("comments-list");
  const form = document.getElementById("comment-form");
  const starPicker = document.getElementById("star-picker");
  const stars = [...starPicker.querySelectorAll("[data-star]")];

  const escapeHtml = (str) => str.replace(/[&<>"']/g, (m) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[m]));

  function renderStars(value) {
    stars.forEach((s) => s.classList.toggle("active", Number(s.dataset.star) <= value));
  }
  renderStars(Number(starPicker.dataset.value));
  stars.forEach((s) => s.addEventListener("click", () => {
    starPicker.dataset.value = s.dataset.star;
    renderStars(Number(s.dataset.star));
  }));

  function renderComments() {
    const stored = JSON.parse(localStorage.getItem(commentsKey) || "[]");
    const all = [...stored, ...seed];
    list.innerHTML = all.map((c) => `
      <div class="comment-card">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="grid h-9 w-9 place-items-center rounded-full bg-brand-700 text-sm font-bold text-white">${escapeHtml(c.name.charAt(0))}</span>
            <div><p class="font-bold">${escapeHtml(c.name)}</p><p class="text-xs text-slate-500">${escapeHtml(c.date)}</p></div>
          </div>
          <span class="text-amber-400">${"★".repeat(c.rating)}${"☆".repeat(5 - c.rating)}</span>
        </div>
        <p class="mt-3 text-sm leading-6 text-slate-600">${escapeHtml(c.text)}</p>
      </div>
    `).join("");
  }
  renderComments();

  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const name = document.getElementById("comment-name").value.trim();
    const text = document.getElementById("comment-text").value.trim();
    const rating = Number(starPicker.dataset.value) || 5;
    if (!name || !text) return;
    const stored = JSON.parse(localStorage.getItem(commentsKey) || "[]");
    stored.unshift({ name, text, rating, date: new Date().toLocaleDateString("fr-FR", { month: "long", year: "numeric" }) });
    localStorage.setItem(commentsKey, JSON.stringify(stored));
    form.reset();
    starPicker.dataset.value = "5";
    renderStars(5);
    renderComments();
  });
</script>
<script>
  document.querySelectorAll("[data-favorite]").forEach((button) => {
    const slug = button.dataset.favorite;
    const favorites = JSON.parse(localStorage.getItem("gabon-favorites") || "[]");
    const active = favorites.includes(slug);
    if (button.classList.contains("favorite-btn")) button.textContent = active ? "♥ Dans vos favoris" : "♡ Ajouter aux favoris";
    button.addEventListener("click", () => {
      const current = JSON.parse(localStorage.getItem("gabon-favorites") || "[]");
      const next = current.includes(slug) ? current.filter((x) => x !== slug) : [...current, slug];
      localStorage.setItem("gabon-favorites", JSON.stringify(next));
      button.textContent = next.includes(slug) ? "♥ Dans vos favoris" : "♡ Ajouter aux favoris";
    });
  });
</script>