---
import Layout from "../layouts/Layout.astro"; import Header from "../components/Header.astro"; import Footer from "../components/Footer.astro"; import { destinations } from "../data/destinations"; import Icon from "../components/Icon.astro"; const base=import.meta.env.BASE_URL;
---
<Layout title="Mes favoris — ExploreGabon"><Header/><main><section class="page-hero"><div class="container-site"><p class="section-eyebrow">Votre sélection</p><h1 class="page-title">Mes favoris</h1><p class="page-lead">Retrouvez les destinations que vous avez enregistrées sur cet appareil.</p></div></section><section class="section-pad"><div class="container-site"><div id="favorites-grid" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3"></div><div id="favorites-empty" class="empty-state"><Icon name="heart" class="mx-auto h-9 w-9"/><h2 class="mt-4 text-xl font-black">Aucun favori pour le moment</h2><p class="mt-2 text-sm text-slate-500">Ajoutez des destinations depuis le catalogue.</p><a href={`${base}destinations/`} class="btn-primary mt-6 inline-flex">Voir les destinations</a></div></div></section></main><Footer/></Layout>
<script define:vars={{destinations,base}}>
const ids=JSON.parse(localStorage.getItem('gabon-favorites')||'[]'),selected=destinations.filter(d=>ids.includes(d.slug)),grid=document.getElementById('favorites-grid'),empty=document.getElementById('favorites-empty');if(selected.length){empty.classList.add('hidden');selected.forEach(d=>{const el=document.createElement('article');el.className='destination-card overflow-hidden rounded-2xl border border-slate-200 bg-white';el.innerHTML=`<a href="${base}destinations/${d.slug}/" class="block"><div class="aspect-[4/3] overflow-hidden"><img src="${d.image}" alt="${d.name}" class="h-full w-full object-cover"></div><div class="p-5"><p class="text-xs font-semibold text-slate-500">${d.province}</p><h3 class="mt-2 text-lg font-black">${d.name}</h3><p class="mt-2 text-sm text-slate-600">${d.short}</p></div></a>`;grid.appendChild(el)})}
</script>
