---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { destinations } from "../data/destinations";
const base = import.meta.env.BASE_URL;
---
<Layout title="Mes favoris — ExploreGabon">
  <Header />
  <main>
    <section class="border-b border-slate-200 bg-slate-50 py-14"><div class="container-site"><p class="text-sm font-bold uppercase tracking-wider text-brand-700">Votre sélection</p><h1 class="mt-2 text-4xl font-extrabold tracking-tight">Mes favoris</h1><p class="mt-3 text-slate-600">Les destinations enregistrées sont stockées localement dans votre navigateur.</p></div></section>
    <section class="section-pad"><div class="container-site"><div id="favorites-grid" class="grid gap-6 md:grid-cols-2 lg:grid-cols-3"></div><div id="favorites-empty" class="rounded-3xl border border-dashed border-slate-300 p-14 text-center"><div class="text-4xl">♡</div><h2 class="mt-4 text-xl font-extrabold">Aucun favori pour le moment</h2><p class="mt-2 text-sm text-slate-500">Ajoutez des destinations depuis le catalogue.</p><a href={`${base}destinations/`} class="mt-6 inline-block rounded-xl bg-brand-700 px-5 py-3 text-sm font-bold text-white">Voir les destinations</a></div></div></section>
  </main>
  <Footer />
</Layout>
<script define:vars={{ destinations, base }}>
  const all = JSON.parse(localStorage.getItem("gabon-favorites") || "[]");
  const selected = destinations.filter((destination) => all.includes(destination.slug));
  const grid = document.getElementById("favorites-grid");
  const empty = document.getElementById("favorites-empty");

  if (selected.length) {
    empty?.classList.add("hidden");
    selected.forEach((destination) => {
      const wrap = document.createElement("div");
      wrap.innerHTML = `
        <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white card-lift">
          <a href="${base}destinations/${destination.slug}/" class="block">
            <div class="aspect-[4/3] overflow-hidden">
              <img src="${destination.image}" alt="${destination.name}" loading="lazy" class="h-full w-full object-cover">
            </div>
            <div class="p-5">
              <div class="text-xs font-semibold text-slate-500">📍 ${destination.province}</div>
              <h3 class="mt-1 text-lg font-extrabold">${destination.name}</h3>
              <p class="mt-2 text-sm text-slate-600">${destination.short}</p>
            </div>
          </a>
        </article>`;
      grid?.appendChild(wrap);
    });
  }
</script>
