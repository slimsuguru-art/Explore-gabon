---
import Layout from "../../layouts/Layout.astro"; import Header from "../../components/Header.astro"; import Footer from "../../components/Footer.astro"; import Icon from "../../components/Icon.astro"; import { regions } from "../../data/regions"; const base=import.meta.env.BASE_URL;
---
<Layout title="Régions — ExploreGabon"><Header/><main><section class="page-hero"><div class="container-site"><p class="section-eyebrow">Territoire</p><h1 class="page-title">Explorez le Gabon région par région.</h1><p class="page-lead">Une base visuelle pour parcourir les neuf provinces du pays.</p></div></section><section class="section-pad"><div class="container-site grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{regions.map(r=><article class="region-card reveal"><div class="image-zoom aspect-[16/10]"><img src={r.image} alt={r.name} loading="lazy" class="h-full w-full object-cover"/></div><div class="p-5"><h2 class="text-xl font-black">{r.name}</h2><p class="mt-1 text-sm text-slate-500">{r.count} destinations dans le prototype</p><a href={`${base}destinations/?province=${encodeURIComponent(r.name)}`} class="mt-5 inline-flex items-center gap-1 text-sm font-bold text-brand-700">Explorer <Icon name="arrow" class="h-4 w-4"/></a></div></article>)}</div></section></main><Footer/></Layout>
