---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { regions } from "../../data/regions";
const base = import.meta.env.BASE_URL;
---
<Layout title="Régions — ExploreGabon">
  <Header />
  <main>
    <section class="border-b border-slate-200 bg-slate-50 py-14">
      <div class="container-site"><p class="text-sm font-bold uppercase tracking-wider text-brand-700">Territoire</p><h1 class="mt-2 text-4xl font-extrabold tracking-tight">Explorez le Gabon région par région.</h1><p class="mt-3 max-w-2xl text-slate-600">Une base visuelle pour parcourir les neuf provinces du pays.</p></div>
    </section>
    <section class="section-pad">
      <div class="container-site grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {regions.map((region) => (
          <article class="reveal group overflow-hidden rounded-2xl border border-slate-200 bg-white card-lift">
            <div class="image-zoom aspect-[16/10]"><img src={region.image} alt={region.name} loading="lazy" class="h-full w-full object-cover" /></div>
            <div class="p-5"><h2 class="text-xl font-extrabold transition-colors group-hover:text-brand-700">{region.name}</h2><p class="mt-1 text-sm text-slate-500">{region.count} destinations dans le prototype</p><a href={`${base}destinations/?province=${encodeURIComponent(region.name)}`} class="mt-5 inline-block text-sm font-bold text-brand-700">Explorer →</a></div>
          </article>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>