---
import Layout from "../../layouts/Layout.astro"; import Header from "../../components/Header.astro"; import Footer from "../../components/Footer.astro"; import Icon from "../../components/Icon.astro"; import { experiences } from "../../data/experiences"; const base=import.meta.env.BASE_URL;
---
<Layout title="Expériences — ExploreGabon"><Header/><main><section class="page-hero"><div class="container-site"><p class="section-eyebrow">Inspiration</p><h1 class="page-title">Voyagez selon vos envies.</h1><p class="page-lead">Trouvez une destination en partant de l'expérience que vous souhaitez vivre.</p></div></section><section class="section-pad"><div class="container-site grid gap-5 sm:grid-cols-2 lg:grid-cols-4">{experiences.map(e=><a href={`${base}destinations/?category=${encodeURIComponent(e.category)}`} class="experience-card reveal"><span class="experience-icon"><Icon name={e.icon} class="h-7 w-7"/></span><h2 class="mt-8 text-xl font-black">{e.title}</h2><p class="mt-3 text-sm leading-6 text-slate-500">{e.description}</p><span class="mt-6 inline-flex items-center gap-1 text-sm font-bold text-brand-700">Découvrir <Icon name="arrow" class="h-4 w-4"/></span></a>)}</div></section></main><Footer/></Layout>
