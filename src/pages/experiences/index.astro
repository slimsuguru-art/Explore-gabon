---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { experiences } from "../../data/experiences";
const base = import.meta.env.BASE_URL;
---
<Layout title="Expériences — ExploreGabon">
  <Header />
  <main>
    <section class="border-b border-slate-200 bg-slate-50 py-14">
      <div class="container-site"><p class="text-sm font-bold uppercase tracking-wider text-brand-700">Inspirations</p><h1 class="mt-2 text-4xl font-extrabold tracking-tight">Voyagez selon vos envies.</h1><p class="mt-3 max-w-2xl text-slate-600">Trouvez une destination en partant de l'expérience que vous souhaitez vivre.</p></div>
    </section>
    <section class="section-pad">
      <div class="container-site grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {experiences.map((experience) => (
          <a href={`${base}destinations/?category=${encodeURIComponent(experience.category)}`} class="reveal card-lift rounded-3xl border border-slate-200 bg-white p-7">
            <span class="text-5xl">{experience.icon}</span><h2 class="mt-8 text-xl font-extrabold">{experience.title}</h2><p class="mt-3 text-sm leading-6 text-slate-500">{experience.description}</p><span class="mt-6 inline-block text-sm font-bold text-brand-700">Découvrir →</span>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>